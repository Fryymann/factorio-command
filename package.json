{
  "name": "factorio-chain-planner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Production-chain calculator, module planner and blueprint generator for Factorio 2.1.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run format:check && npm run test",
    "extract-data": "node scripts/extract-data.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
